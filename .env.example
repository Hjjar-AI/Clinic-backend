#
# Backend environment: manage.py loads this before selecting settings.
# Copy .env.example only when .env is absent; keep .env private/ignored.
# Shell variables and Django --settings override local choices.
# Explicit config.settings.testing skips local .env to preserve test isolation.
# Switch DB/cache by replacing active assignments, not appending duplicates.
# Restart running processes after edits. Changing DB does not move data.

# --- APPLICATION MODE AND NETWORK ---
# Management entry: python manage.py runserver 127.0.0.1:5019
# Development accepts SQLite + local cache and honors debug/hosts below.
# Production requires HTTPS, external DB/shared cache and real hostnames:
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=clinic.example.com
# CORS_ORIGINS=https://clinic.example.com
# WSGI defaults production; explicitly configure its process environment.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=Asia/Damascus

# --- SECURITY KEYS ---
# Keep separate, nonempty private keys; never commit actual values.
# Keys are required when DJANGO_DEBUG=false; retain HMAC keys for old backups.
# Generate DJANGO_SECRET_KEY:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# Generate BACKUP_HMAC_KEY:
# python -c 'import secrets; print(secrets.token_hex(32))'
DJANGO_SECRET_KEY=
BACKUP_HMAC_KEY=

# --- DATABASE: CHOOSE ONE BACKEND ---
# SQLite profile: pip install -r requirements/sqlite.txt (no DB driver).
# Accepted aliases: sqlite/sqlite3, postgres/postgresql, mysql, maria/mariadb.
# Full Django backend paths also work; install their drivers separately.
# SQLite names: backend-relative path, absolute path, :memory:, file: URI.
# Blank name uses data/clinic.db. SQLite ignores user/password/host/port.
# WAL init commands apply on Django 5.1+; Django 5.0 retains native FK handling.
# DATABASE_TIMEOUT is SQLite-only; external connections use CONN_MAX_AGE.
#
# PostgreSQL: pip install -r requirements/postgresql.txt
# DATABASE_ENGINE=postgresql
# DATABASE_NAME=clinic
# DATABASE_USER=clinic
# DATABASE_PASSWORD="replace-with-private-password"
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_SSLMODE=verify-full
# DATABASE_SSL_CA=/absolute/path/to/root-ca.pem
# SSLMODE can be disable/prefer/require/verify-ca/verify-full; match server policy.
#
# MySQL: pip install -r requirements/mysql.txt
# MariaDB: pip install -r requirements/mariadb.txt (same Django backend/driver).
# DATABASE_ENGINE=mysql                # or mariadb
# DATABASE_NAME=clinic
# DATABASE_USER=clinic
# DATABASE_PASSWORD="replace-with-private-password"
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_SSL_CA=/absolute/path/to/root-ca.pem
# Use an InnoDB/utf8mb4 database; settings enable utf8mb4 + strict SQL mode.
# MySQL ignores SSLMODE; its TLS options can be specified in DATABASE_OPTIONS.
#
# Other installed backend: DATABASE_ENGINE=package.backend
# DATABASE_OPTIONS is an optional JSON object passed to the selected driver.
# Example PostgreSQL timeout: DATABASE_OPTIONS='{"connect_timeout":10}'
# Driver options override defaults; keep SQL/SSL choices deliberate.
# Selecting another DB never copies records or initializes schema.
DATABASE_ENGINE=sqlite
DATABASE_NAME=data/clinic.db
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_TIMEOUT=20
DATABASE_CONN_MAX_AGE=600
DATABASE_SSLMODE=
DATABASE_SSL_CA=
DATABASE_OPTIONS='{}'

# --- CACHE: CHOOSE ONE BACKEND ---
# Local memory: no extra package; single-process development only.
# Production rejects LocMemCache; select a shared service below.
#
# Memcached: pip install -r requirements/cache-memcached.txt
# CACHE_BACKEND=django.core.cache.backends.memcached.PyMemcacheCache
# CACHE_LOCATION=127.0.0.1:11211
# Linux service: sudo systemctl enable --now memcached
#
# Redis: pip install -r requirements/cache-redis.txt
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
# TLS/auth example: rediss://:password@cache.example.com:6379/1
# Install/run cache servers separately; changing drivers does not start them.
# Blank backend defaults LocMemCache; blank location uses backend default.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=unique-snowflake

# --- SESSION, LOGIN AND OPTIONAL SEED PASSWORDS ---
# SESSION_COOKIE_AGE is seconds (10800 = three hours).
# SESSION_COOKIE_SECURE=true for HTTPS; production forces secure session/CSRF.
# Optional seed inputs are used only for newly created seed accounts.
# Blank seed inputs generate random passwords; seed_db prints new passwords
# once (including supplied values), so protect its output. No automatic seed.
SESSION_COOKIE_SECURE=False            # True when using HTTPS
SESSION_COOKIE_AGE=10800                # seconds (3 hours)
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
ADMIN_PASSWORD=
DOCTOR_PASSWORD=
RECEPTIONIST_PASSWORD=

# --- CLINIC IDENTITY AND DOCUMENT DEFAULTS ---
# TIME_ZONE above controls business dates; clinic settings may hold saved overrides.
# PDF fonts come from bundled frontend Cairo/Inter assets. PDF_FONT_DIR is a
# Django setting for deployed assets, not a currently parsed .env variable.
CLINIC_NAME=عيادة كذا
CLINIC_ADDRESS=
CLINIC_PHONE=
DEFAULT_PRESCRIPTION_INSTRUCTION=حسب تعليمات الطبيب

# --- WORKING HOURS AND APPOINTMENTS ---
# Clinic-local 24-hour time; default appointment duration in minutes.
WORK_START_HOUR=8
WORK_START_MINUTE=0
WORK_END_HOUR=23
WORK_END_MINUTE=30
DEFAULT_APPOINTMENT_DURATION=30
MAX_APPOINTMENTS_PER_VIEW=500

# --- UPLOAD LIMITS ---
# Values in MB; match reverse-proxy upload limits to MAX_CONTENT_LENGTH.
# Runtime media/database/backups are ignored; production patient bytes must
# use authorized download endpoints rather than public /media/ aliases.
MAX_BULK_IMPORT_SIZE=200
MAX_ATTACHMENT_SIZE=10
MAX_CONTENT_LENGTH=210

# --- SCHEDULER, BACKUPS AND NOTIFICATION RETENTION ---
# run_scheduler is development-only; production uses individual timers.
# Intervals in hours; retention in days. auto_backup creates on EVERY call.
# BACKUP_CHECK_INTERVAL_HOURS is declared/reserved, not an auto_backup gate.
# Backups: all within SAFETY, then newest/ISO week through WEEKLY, newest/month
# through MONTHLY, then newest/year forever. Preserve signing keys off-site.
# BACKUP_WEEKDAY_MIN_DAYS is obsolete and intentionally omitted.
SCHEDULER_INTERVAL_HOURS=2
BACKUP_CHECK_INTERVAL_HOURS=6
BACKUP_SAFETY_DAYS=13
BACKUP_WEEKLY_DAYS=90
BACKUP_MONTHLY_DAYS=365
NOTIFICATION_READ_RETENTION_DAYS=90
NOTIFICATION_UNREAD_RETENTION_DAYS=365

# --- DEMO DATA AND RESERVED FLAGS ---
# Production forces both flags false. Demo generation is an explicit command/API.
# AUTO_SEED is reserved; it does not cause startup initialization.
# Existing local choices are retained; set ALLOW_DEMO_DATA=false for real use.
ALLOW_DEMO_DATA=true
AUTO_SEED=true
DEMO_PATIENTS_COUNT=10
DEMO_VISITS_PER_PATIENT=3
