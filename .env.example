# One local configuration for backend/start.* and frontend/start.*.
# start.* configure creates private .env and generates both keys once.
# Existing .env is never replaced. Shell variables override local values.

# Local launcher: literal values; paths with spaces may be quoted.
CLINIC_BACKEND_PORT=5019
CLINIC_FRONTEND_PORT=5173
CLINIC_OPEN_BROWSER=true
# Optional interpreter paths; default Python: .venv, venv, then launcher Python.
CLINIC_PYTHON=
CLINIC_NODE=

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=Asia/Damascus
DJANGO_SECRET_KEY=
BACKUP_HMAC_KEY=

# Choose one database; selecting it never moves data or initializes schema.
# requirements/sqlite.txt (default, local only)
# requirements/postgresql.txt: DATABASE_ENGINE=postgresql, port 5432
# requirements/mysql.txt or mariadb.txt: engine mysql/mariadb, port 3306
DATABASE_ENGINE=sqlite
DATABASE_NAME=data/clinic.db
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_TIMEOUT=20
DATABASE_CONN_MAX_AGE=600
DATABASE_SSLMODE=
DATABASE_SSL_CA=
DATABASE_OPTIONS='{}'

# Production requires an external DB, shared cache, explicit hosts and HTTPS.
# Redis: requirements/cache-redis.txt; backend django.core.cache.backends.redis.RedisCache
#        location redis://127.0.0.1:6379/1
# Memcached: requirements/cache-memcached.txt; backend django.core.cache.backends.memcached.PyMemcacheCache
#            location 127.0.0.1:11211
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=unique-snowflake
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_AGE=10800
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# Clinic identity/document defaults; saved clinic settings may override these.
CLINIC_NAME="عيادة الصحة"
CLINIC_ADDRESS=
CLINIC_PHONE=
DEFAULT_PRESCRIPTION_INSTRUCTION="حسب تعليمات الطبيب"

# Clinic-local working hours; appointment duration in minutes.
WORK_START_HOUR=8
WORK_START_MINUTE=0
WORK_END_HOUR=23
WORK_END_MINUTE=30
DEFAULT_APPOINTMENT_DURATION=30
MAX_APPOINTMENTS_PER_VIEW=500

# Upload limits in MiB; match the reverse-proxy request limit.
MAX_BULK_IMPORT_SIZE=200
MAX_ATTACHMENT_SIZE=10
MAX_CONTENT_LENGTH=210

# Development scheduler intervals in hours; retention windows in days.
# BACKUP_CHECK_INTERVAL_HOURS gates scheduler backups, not direct auto_backup calls.
SCHEDULER_INTERVAL_HOURS=2
BACKUP_CHECK_INTERVAL_HOURS=6
BACKUP_SAFETY_DAYS=30
BACKUP_WEEKLY_DAYS=90
BACKUP_MONTHLY_DAYS=365
NOTIFICATION_READ_RETENTION_DAYS=90
NOTIFICATION_UNREAD_RETENTION_DAYS=365

# Native Windows libraries: install MSYS2 UCRT64 Pango/file first.
# CLINIC_DLL_DIRECTORIES=C:/msys64/ucrt64/bin
# WEASYPRINT_DLL_DIRECTORIES=C:/msys64/ucrt64/bin
# LIBMAGIC_DATABASE=C:/msys64/ucrt64/share/misc/magic.mgc
# PDF_FONT_DIR=C:/Clinic/fonts
# Non-PostgreSQL production: shared/exclusive-capable storage for all workers/jobs.
# OPERATION_LOCK_DIR=C:/Clinic/locks

ALLOW_DEMO_DATA=false
# Reserved flag; startup never seeds automatically.
AUTO_SEED=false
DEMO_PATIENTS_COUNT=10
DEMO_VISITS_PER_PATIENT=3
# Optional passwords apply only when explicitly seeding NEW accounts.
# ADMIN_PASSWORD=
# DOCTOR_PASSWORD=
# RECEPTIONIST_PASSWORD=
# Other clinic/work-hours/upload/retention defaults: config/settings/base.py.
