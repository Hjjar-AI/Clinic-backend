# ================================================================
#  Clinic Management System – Django Environment Configuration
# ================================================================
#  All variables are read by config/settings/base.py via load_dotenv.
#  Lines starting with # are comments.
# ================================================================


# ----------------------------------------------------------------
#  1. SECURITY
# ----------------------------------------------------------------
# !! ROTATED AFTER ACCIDENTAL EXPOSURE !!
# The previous DJANGO_SECRET_KEY and BACKUP_HMAC_KEY were included in
# a shared file dump. Treat them as compromised. Generate fresh values:
#   DJANGO_SECRET_KEY:
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   BACKUP_HMAC_KEY:
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Leave these empty in the repo. The settings module raises RuntimeError
# at startup when DEBUG=False and either value is blank, so a production
# deployment cannot boot with a placeholder secret.
DJANGO_SECRET_KEY=
BACKUP_HMAC_KEY=


# ----------------------------------------------------------------
#  2. SERVER & DEBUG
# ----------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ----------------------------------------------------------------
#  3. DATABASE
# ----------------------------------------------------------------
# Default: SQLite for local development. Production must override:
#   DATABASE_ENGINE=django.db.backends.postgresql
#   DATABASE_NAME=clinic
#   DATABASE_USER=clinic
#   DATABASE_PASSWORD=<secret>
#   DATABASE_HOST=127.0.0.1
#   DATABASE_PORT=5432
# config/settings/production.py raises at import time if this is left as
# SQLite. See base.py for the parsing logic.
# DATABASE_ENGINE=django.db.backends.sqlite3


# ----------------------------------------------------------------
#  4. SESSION & AUTHENTICATION
# ----------------------------------------------------------------
SESSION_COOKIE_SECURE=False            # True when using HTTPS
SESSION_COOKIE_AGE=10800                # seconds (3 hours)
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15


# ----------------------------------------------------------------
#  5. CUSTOM APPLICATION SETTINGS
# ----------------------------------------------------------------
CLINIC_NAME=عيادة الإتزان
CLINIC_ADDRESS=
CLINIC_PHONE=
DEFAULT_PRESCRIPTION_INSTRUCTION=حسب تعليمات الطبيب
ALLOW_DEMO_DATA=true
AUTO_SEED=true


# ----------------------------------------------------------------
#  6. WORKING HOURS & APPOINTMENTS
# ----------------------------------------------------------------
WORK_START_HOUR=8
WORK_START_MINUTE=0
WORK_END_HOUR=23
WORK_END_MINUTE=30
DEFAULT_APPOINTMENT_DURATION=30
MAX_APPOINTMENTS_PER_VIEW=500


# ----------------------------------------------------------------
#  7. FILE UPLOAD LIMITS (MB)
# ----------------------------------------------------------------
MAX_BULK_IMPORT_SIZE=200
MAX_ATTACHMENT_SIZE=10
MAX_CONTENT_LENGTH=210


# ----------------------------------------------------------------
#  8. DEMO DATA SETTINGS
# ----------------------------------------------------------------
DEMO_PATIENTS_COUNT=10
DEMO_VISITS_PER_PATIENT=3


# ----------------------------------------------------------------
#  9. SCHEDULER & BACKUP
# ----------------------------------------------------------------
SCHEDULER_INTERVAL_HOURS=2
BACKUP_CHECK_INTERVAL_HOURS=6

# Backup retention windows in days. Consumed by apps/backup/retention.py
# (via Django settings, which read these same keys):
#
#   BACKUP_SAFETY_DAYS   -- keep every backup from the last N days
#   BACKUP_WEEKLY_DAYS   -- from N days back up to the safety window,
#                           reduce to one backup per ISO week
#   BACKUP_MONTHLY_DAYS  -- from N days back up to the weekly window,
#                           reduce to one backup per calendar month
#
# Anything older than BACKUP_MONTHLY_DAYS is further reduced to one per
# calendar year.
BACKUP_SAFETY_DAYS=13
BACKUP_WEEKLY_DAYS=90
BACKUP_MONTHLY_DAYS=365


# ----------------------------------------------------------------
#  10. CACHE
# ----------------------------------------------------------------
# Default: process-local LocMemCache for local development. Production
# must override with a shared backend, because invalidate_group() in
# core/cache_utils.py is a cross-process scheme. Production raises at
# import time if CACHE_BACKEND is left unset or points at LocMemCache:
#   CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
#   CACHE_LOCATION=redis://127.0.0.1:6379/1
#CACHE_BACKEND=django.core.cache.backends.memcached.PyMemcacheCache
#CACHE_LOCATION=127.0.0.1:11211